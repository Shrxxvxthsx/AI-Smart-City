rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Reports
    match /reports/{reportId} {
      function isValidReport(data) {
        return data.citizenId is string &&
               data.category in ['traffic', 'pollution', 'waste', 'water', 'energy', 'agriculture', 'safety'] &&
               data.description is string && data.description.size() <= 2000 &&
               data.status in ['pending', 'in-progress', 'resolved', 'escalated'];
      }

      allow read: if true; // Public dashboard can see reports
      allow create: if isSignedIn() && isValidReport(request.resource.data) && request.resource.data.citizenId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Citizens can only update their own reports (e.g. adding more info if we allowed it, but here mostly for status changes by dept)
        (isOwner(resource.data.citizenId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'imageUrl'])) ||
        // Department heads / workers (simplifying for this demo - anyone signed in can update status for now, in real app check roles)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'priority', 'assignedDept', 'aiAnalysis', 'updatedAt']))
      );
      allow delete: if false; // No deletion for audit trail
    }

    // Metrics (Read-only for public, write for system/admin)
    match /metrics/{metricId} {
      allow read: if true;
      allow write: if isSignedIn(); // System logic or admin
    }

    // Departments
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
